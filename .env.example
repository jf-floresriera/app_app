# Copie este archivo a .env (o defina las variables en el servicio de despliegue).
# El servidor lee variables de entorno; no carga .env por sí mismo:
#   export $(grep -v '^#' .env | xargs) && npm start
PORT=3000
ADMIN_PASSWORD=cambie-esta-clave
DURATION_MINUTES=30
MAX_VIOLATIONS=3
ALLOWED_EMAIL_DOMAIN=unal.edu.co
DATA_DIR=./data
